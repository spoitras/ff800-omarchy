#!/usr/bin/env bash
# Manage the RME Fireface 800 audio stack on Omarchy.
#
# Architecture: jackd owns the FF800 through its FFADO backend and holds the
# hardware stream open for the server's whole lifetime. PipeWire attaches as an
# ordinary JACK client via module-jack-tunnel.
#
# This deliberately avoids libpipewire-module-ffado-driver, which has a
# use-after-free between its data loop (ffado_streaming_wait) and teardown
# (ffado_streaming_finish). PipeWire closes hardware streams whenever the last
# client disconnects -- by design -- so that path crashed the whole PipeWire
# process, and with it all system audio, every time playback ended.

set -uo pipefail
AVAIL="$HOME/.config/pipewire/ffado-available"
CONFD="$HOME/.config/pipewire/pipewire.conf.d"
TUNNEL=30-jack-tunnel.conf
SVC=jackd-ff800.service
RME_VENDOR="0x000a35"
GUID=000a35005b685205

# Everything `ff800 on` decides also goes to the journal. The bar plugin
# collects stdout into a QML string and discards it on success, so a start that
# failed and recovered left no record of *why* anywhere -- which is exactly the
# run you want to read afterwards. `ff800 log` prints it back.
say()  { echo "$*";     logger -t ff800 -- "$*" 2>/dev/null; }
warn() { echo "$*" >&2; logger -t ff800 -p user.warning -- "$*" 2>/dev/null; }
note() {                logger -t ff800 -- "$*" 2>/dev/null; }   # journal only

device_present() {
    for d in /sys/bus/firewire/devices/fw*; do
        [ -r "$d/vendor" ] || continue
        [ "$(cat "$d/vendor" 2>/dev/null)" = "$RME_VENDOR" ] && return 0
    done
    return 1
}

jack_probe() {  # prints "<rate> <buffer> <ports> <dsp%>" or nothing
    # MUST stay under timeout: jack_client_open never returns against a server
    # that is hung in the FFADO device open, which is a real failure mode here.
    timeout 10 python3 - <<'PY' 2>/dev/null
import ctypes
try: lib=ctypes.CDLL("libjack.so.0")
except OSError: raise SystemExit
lib.jack_client_open.restype=ctypes.c_void_p
lib.jack_client_open.argtypes=[ctypes.c_char_p,ctypes.c_int,ctypes.c_void_p]
lib.jack_get_sample_rate.restype=ctypes.c_uint32; lib.jack_get_sample_rate.argtypes=[ctypes.c_void_p]
lib.jack_get_buffer_size.restype=ctypes.c_uint32; lib.jack_get_buffer_size.argtypes=[ctypes.c_void_p]
lib.jack_cpu_load.restype=ctypes.c_float; lib.jack_cpu_load.argtypes=[ctypes.c_void_p]
lib.jack_get_ports.restype=ctypes.POINTER(ctypes.c_char_p)
lib.jack_get_ports.argtypes=[ctypes.c_void_p,ctypes.c_char_p,ctypes.c_char_p,ctypes.c_ulong]
c=lib.jack_client_open(b"ff800-status",1,None)   # 1 = JackNoStartServer
if not c: raise SystemExit
p=lib.jack_get_ports(ctypes.c_void_p(c),None,None,0); i=0
while p and p[i]: i+=1
print(f"{lib.jack_get_sample_rate(c)} {lib.jack_get_buffer_size(c)} {i} {lib.jack_cpu_load(ctypes.c_void_p(c)):.1f}")
lib.jack_client_close(ctypes.c_void_p(c))
PY
}

jack_info() {   # prints "<rate> Hz / <buffer> frames / <n> ports" or nothing
    local rate buf ports dsp
    read -r rate buf ports dsp < <(jack_probe)
    [ -n "$rate" ] && echo "$rate Hz / $buf frames / $ports ports"
}

# jackd logs every xrun it notices; scoping the grep to the unit's current
# InvocationID keeps the count per-session instead of per-boot, so `ff800 on`
# always starts from zero.
xrun_count() {
    local inv count
    inv=$(systemctl --user show -p InvocationID --value "$SVC" 2>/dev/null)
    [ -n "$inv" ] || { echo 0; return; }
    count=$(journalctl --user "_SYSTEMD_INVOCATION_ID=$inv" --no-pager -o cat 2>/dev/null \
              | grep -ci xrun)
    echo "${count:-0}"
}

# One-line machine-readable status, for the Omarchy bar plugin and anything
# else that would rather not parse the human output.
status_json() {
    local dev jackd pw bridge rate buf ports dsp xruns state probe
    device_present && dev=true || dev=false
    jackd=$(systemctl --user is-active "$SVC" 2>/dev/null)
    pw=$(systemctl --user is-active pipewire 2>/dev/null)
    [ -L "$CONFD/$TUNNEL" ] && bridge=true || bridge=false
    rate=0; buf=0; ports=0; dsp=0; xruns=0
    if [ "$jackd" = active ]; then
        probe=$(jack_probe)
        [ -n "$probe" ] && read -r rate buf ports dsp <<<"$probe"
        xruns=$(xrun_count)
    fi
    # "partial" is jackd up but either unreachable or not bridged to PipeWire:
    # audio works for JACK clients and not for the desktop, which is worth
    # showing differently from a clean on/off.
    if   [ "$jackd" = failed ];                     then state=failed
    elif [ "$jackd" = active ] && [ "$rate" != 0 ]; then
        [ "$bridge" = true ] && state=on || state=partial
    elif [ "$jackd" = active ];                     then state=partial
    elif [ "$dev" = false ];                        then state=absent
    else                                                 state=off
    fi
    printf '{"state":"%s","device":%s,"jackd":"%s","pipewire":"%s","bridge":%s,' \
        "$state" "$dev" "$jackd" "$pw" "$bridge"
    printf '"rate":%s,"buffer":%s,"ports":%s,"dsp":%s,"xruns":%s}\n' \
        "$rate" "$buf" "$ports" "$dsp" "$xruns"
}

# The FF800 does NOT reliably retain its clock mode across a power cycle: it
# comes back in slave/AutoSync mode, and with no external clock connected it
# then refuses to set its sample rate, so jackd fails with
#   "FFADO: Error creating virtual device"
# and libffado reports
#   "slave clock mode active but no valid external clock present".
# Force it back to master before every start. Mixer access (ffado-dbus-server)
# is separate from streaming access, so this is safe to do here.
# NOTE: "ffado-dbus-server" is 17 chars, over pgrep/pkill's 15-char comm limit,
# so these must match on the full command line, with a bracket to avoid
# matching this script's own command line.
DBUS_PAT='ffado-dbus-serve[r]'

# Settle time after a clock-mode change, before jackd may open the device.
#
# MEASURED 2026-09-05, and it is NOT what fixes the first-start failure. A run
# with a read-back-verified write to master and a full 12s settle still failed
# the open in 1s -- and the next clock check, 13s later, found the mode back on
# slave with nothing but that failed open in between. Both attempts of that run
# were structurally identical (write, stop daemon, settle, start); the only
# thing distinguishing the one that worked is that a failed FFADO open preceded
# it. So the first open after a power cycle fails regardless, and the retry
# below is what actually recovers the start.
#
# Kept small rather than removed because no run has yet tried zero. To measure:
#   FF800_CLOCK_SETTLE=0 ff800 on   # then: ff800 log
CLOCK_SETTLE=${FF800_CLOCK_SETTLE:-3}

stop_dbus_server() {
    pkill -f "$DBUS_PAT" 2>/dev/null
    # Wait for it to actually let go: jackd's open fails outright if anything
    # else still holds the device, and SIGTERM is not instant here.
    local i
    for i in $(seq 10); do
        pgrep -f "$DBUS_PAT" >/dev/null || return 0
        sleep 1
    done
    warn "ff800: ffado-dbus-server ignored SIGTERM; killing it"
    pkill -9 -f "$DBUS_PAT" 2>/dev/null
    sleep 2
}

# 0 = already on master, 10 = was slave and has been switched (the caller must
# let the device settle before opening it), 1 = could not tell.
#
# ffado-dbus-server is D-Bus activatable (/usr/share/dbus-1/services/
# org.ffado.Control.service), so the call below starts it by itself -- no need
# to spawn it here and then guess with a blind sleep how long discovery takes.
# What we do have to do is put things back the way we found them: a daemon that
# was not running before must not be left holding the device when jackd opens
# it, and D-Bus will happily activate one behind our back.
ensure_master_clock() {
    local pre=0 out rc
    pgrep -f "$DBUS_PAT" >/dev/null && pre=1
    out=$(timeout 45 python3 - "$GUID" <<'PYEOF' 2>&1
import sys, time, dbus
guid = sys.argv[1]
path = f'/org/ffado/Control/DeviceManager/{guid}/Control/Clock_mode'
bus = dbus.SessionBus()
# The service claims its bus name before it has finished enumerating the
# FireWire bus, so the control object shows up a few seconds after activation.
deadline = time.time() + 30
while True:
    try:
        i = dbus.Interface(bus.get_object('org.ffado.Control', path),
                           'org.ffado.Control.Element.Discrete')
        value = int(i.getValue())
        break
    except dbus.DBusException as e:
        if time.time() > deadline:
            print(f"ff800: no clock control after 30s ({e})", file=sys.stderr)
            sys.exit(1)
        time.sleep(1)
if value == 0:
    sys.exit(0)
i.setValue(0)
# Read back: a write the device rejects is silent otherwise, and starting jackd
# against a still-slave clock only reproduces the original failure.
if int(i.getValue()) != 0:
    print("ff800: clock mode would not switch to master", file=sys.stderr)
    sys.exit(1)
print("ff800: clock mode was slave -> set to master")
sys.exit(10)
PYEOF
)
    rc=$?
    [ -n "$out" ] && say "$out"
    # Always release the device before jackd opens it -- unless it was already
    # running, in which case it is someone else's (ffado-mixer, typically).
    [ "$pre" = 0 ] && stop_dbus_server
    return $rc
}

# Run the clock check and absorb the relock wait it may ask for.
prepare_clock() {
    local t0=$SECONDS rc
    ensure_master_clock
    rc=$?
    note "ff800: clock check took $((SECONDS - t0))s (rc=$rc)"
    case "$rc" in
        10) say "ff800: clock was slave -> master; letting it relock (${CLOCK_SETTLE}s)"
            sleep "$CLOCK_SETTLE" ;;
        0)  note "ff800: clock already master, no settle needed" ;;
        *)  warn "ff800: clock check failed; starting anyway" ;;
    esac
    return "$rc"
}

jackd_log() {
    journalctl --user -u "$SVC" -n 8 --no-pager -o cat 2>&1 | sed 's/\x1b\[[0-9;]*m//g'
}

# A device wedged by an unclean exit needs `ff800 reset`, not another start.
jackd_wedged() {
    [ "$(systemctl --user show -p Result --value "$SVC" 2>/dev/null)" = core-dump ] && return 0
    jackd_log | grep -qiE 'enabled stream|not busy|segmentation fault'
}

# One start attempt. A failed FFADO open gives up in under a second while a
# good one needs ~7s to bring the ports up, so poll rather than sleep blind:
# failure is noticed immediately and success means the server actually answered.
start_jackd() {
    local i t0=$SECONDS
    systemctl --user reset-failed "$SVC" 2>/dev/null
    systemctl --user start "$SVC" || { warn "ff800: systemctl start failed"; return 1; }
    for i in $(seq 80); do          # 80 * 0.25s = 20s
        sleep 0.25
        if [ "$(systemctl --user is-active "$SVC")" != active ]; then
            note "ff800: jackd open failed after $((SECONDS - t0))s -- $(jackd_log | grep -iEm1 'err|error' | tr -s ' ')"
            return 1
        fi
        # Not before 2s, and every half second after that: a client open
        # against a server whose driver is still attaching is wasted work.
        if [ "$i" -ge 8 ] && [ $((i % 2)) -eq 0 ] && [ -n "$(jack_probe)" ]; then
            note "ff800: jackd up after $((SECONDS - t0))s"
            return 0
        fi
    done
    note "ff800: jackd active but unreachable after $((SECONDS - t0))s"
    return 1    # hung in the device open
}

# Returns once PipeWire is back -- and, when the bridge is linked, once the JACK
# sink has actually appeared. Polling beats the blind sleep this used to do:
# the sink is usually up in about a second, and on the rare slow restart four
# seconds was not enough anyway.
restart_pipewire() {
    local i want_jack=0 last=-1 now
    [ -L "$CONFD/$TUNNEL" ] && want_jack=1
    systemctl --user reset-failed pipewire pipewire-pulse wireplumber 2>/dev/null
    systemctl --user restart pipewire pipewire-pulse wireplumber
    for i in $(seq 40); do          # up to 10s
        sleep 0.25
        [ "$(systemctl --user is-active pipewire)" = active ] || continue
        [ "$want_jack" = 0 ] && return 0
        wpctl status 2>/dev/null | grep -qi 'JACK' || continue
        # The tunnel's ports finish registering a beat after the sink appears,
        # so wait for the count to stop moving -- otherwise the summary line
        # reports a number that is already stale by the time it is printed.
        now=$(jack_probe | cut -d' ' -f3)
        [ -n "$now" ] && [ "$now" = "$last" ] && return 0
        last=${now:--1}
    done
    note "ff800: PipeWire did not settle within 10s"
}

case "${1:-status}" in
  on)
    if ! device_present; then
        warn "ff800: interface is not on the FireWire bus -- power it on first."
        exit 1
    fi
    # Open first, fix the clock only if that fails. The first open after a
    # power cycle fails whatever the clock says, and it reverts the clock to
    # slave on its way out -- so a clock check done *before* it is work whose
    # result that open then throws away. Checking after failure instead saves a
    # whole D-Bus round trip and settle on a cold start, and skips them
    # entirely on a warm one, where the open just succeeds.
    if ! start_jackd; then
        # Decide before stopping the unit -- the stop clears its Result.
        wedged=no; jackd_wedged && wedged=yes
        systemctl --user stop "$SVC" 2>/dev/null
        if [ "$wedged" = yes ]; then
            warn "ff800: jackd failed to start (wedged device). Recent log:"
            jackd_log | sed 's/^/       /' >&2
            echo "       The device is wedged from an unclean exit -- run: ff800 reset" >&2
            exit 1
        fi
        say "ff800: first open failed (expected after a power cycle) -- fixing clock, retrying"
        prepare_clock
        if ! start_jackd; then
            systemctl --user stop "$SVC" 2>/dev/null
            warn "ff800: jackd failed to start twice. Recent log:"
            jackd_log | sed 's/^/       /' >&2
            echo "       If it segfaulted or reports a busy/enabled stream, the device" >&2
            echo "       is wedged from an unclean exit -- run: ff800 reset" >&2
            exit 1
        fi
    fi
    mkdir -p "$CONFD"
    ln -sfn "$AVAIL/$TUNNEL" "$CONFD/$TUNNEL"
    restart_pipewire
    say "ff800: on -- jack $(jack_info)"
    wpctl status 2>/dev/null | grep -i 'JACK' | sed 's/^/       /'
    ;;
  off)
    rm -f "$CONFD/$TUNNEL"
    restart_pipewire
    # Graceful SIGTERM via systemd. Never pkill jackd: an unclean exit leaves
    # isochronous handlers allocated on the controller, and the next open then
    # segfaults with "Enable requested on enabled stream".
    systemctl --user stop "$SVC"
    sleep 2
    say "ff800: off -- jackd $(systemctl --user is-active $SVC), pipewire $(systemctl --user is-active pipewire)"
    ;;
  reset)
    # Recover a device wedged by an unclean exit (red HOST light, "stream
    # enabled" errors, jackd segfault on start).
    systemctl --user stop "$SVC" 2>/dev/null; sleep 2
    ffado-test BusReset >/dev/null 2>&1 && echo "ff800: bus reset ok" || echo "ff800: bus reset FAILED" >&2
    sleep 5
    if ffado-test ListDevices 2>/dev/null | grep -qi 'Fireface'; then
        echo "ff800: device visible again -- run 'ff800 on'"
    else
        echo "ff800: device still not visible; power-cycle the interface." >&2
        exit 1
    fi
    ;;
  status)
    if [ "${2:-}" = "--json" ]; then status_json; exit 0; fi
    device_present && echo "device  : present on bus" || echo "device  : ABSENT (powered off?)"
    jackd=$(systemctl --user is-active "$SVC")
    echo "jackd   : $jackd"
    info=$(jack_info); [ -n "$info" ] && echo "jack    : $info"
    [ "$jackd" = active ] && echo "xruns   : $(xrun_count)"
    [ -L "$CONFD/$TUNNEL" ] && echo "bridge  : enabled" || echo "bridge  : disabled"
    echo "pipewire: $(systemctl --user is-active pipewire)"
    wpctl status 2>/dev/null | grep -i 'JACK' | sed 's/^/          /' || true
    ;;
  clock)
    # `on` only touches the clock when an open fails, so this is the way to
    # assert master by hand -- and to check it without starting anything.
    prepare_clock
    case "$?" in
        0|10) echo "ff800: clock mode is master" ;;
        *)    exit 1 ;;   # prepare_clock has already said why
    esac
    ;;
  json) status_json ;;
  log)
    # What the last starts actually did -- the only record when `on` was driven
    # from the bar plugin rather than a terminal.
    journalctl --user -t ff800 -n "${2:-40}" --no-pager -o short-iso 2>/dev/null
    ;;
  *) echo "usage: ff800 {on|off|status [--json]|json|clock|reset|log [n]}" >&2; exit 2 ;;
esac
